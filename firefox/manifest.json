{
  "manifest_version": 2,
  "name": "VPN IP Watcher",
  "version": "1.0.0",
  "description": "Monitor your external IP and alert when your VPN drops",
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "https://api.ipify.org/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-gray.svg"
    },
    "default_title": "VPN IP Watcher"
  },
  "icons": {
    "48": "icons/icon-gray.svg",
    "96": "icons/icon-gray.svg"
  }
}
